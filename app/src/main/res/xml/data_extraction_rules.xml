<?xml version="1.0" encoding="utf-8"?>
<!-- 排除所有敏感配置文件，防止被 adb backup 或云备份泄露 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
